option(BRQ_EXPORT_LOCALIZATION "Enable the PAK-to-translation-workspace export target" OFF)
option(BRQ_EXPORT_PSD "Include layered PSD files in the translation workspace" ON)
set(BRQ_PAK_ROOT "" CACHE PATH "PAK directory override within the game installation")
if(NOT BRQ_PAK_ROOT)
    set(BRQ_PAK_ROOT "${BRQ_SOURCE_GAME_ROOT}/Data")
endif()
set(BRQ_LOCALIZATION_OUTPUT "" CACHE PATH "Export directory; defaults to translations/<language>")
set(BRQ_GUST_EBM_EXECUTABLE "" CACHE FILEPATH "Native gust_ebm executable")
set(BRQ_GUST_ENC_EXECUTABLE "" CACHE FILEPATH "Optional native gust_enc executable for encrypted-only XML")

if(BRQ_EXPORT_LOCALIZATION)
    if(NOT BRQ_TARGET_LANGUAGE)
        message(FATAL_ERROR "Set BRQ_TARGET_LANGUAGE for translation export")
    endif()
    find_package(Python3 3.11 REQUIRED COMPONENTS Interpreter)
    foreach(tool IN ITEMS G1T EBM)
        if(NOT EXISTS "${BRQ_GUST_${tool}_EXECUTABLE}" OR IS_DIRECTORY "${BRQ_GUST_${tool}_EXECUTABLE}")
            message(FATAL_ERROR "Set BRQ_GUST_${tool}_EXECUTABLE to the native conversion tool")
        endif()
    endforeach()
    if(NOT IS_DIRECTORY "${BRQ_PAK_ROOT}")
        message(FATAL_ERROR "BRQ_PAK_ROOT must contain the original game PAK files")
    endif()
    if(BRQ_LOCALIZATION_OUTPUT)
        set(BRQ_EXPORT_DIRECTORY "${BRQ_LOCALIZATION_OUTPUT}")
    else()
        set(BRQ_EXPORT_DIRECTORY "${BRQ_TRANSLATIONS_ROOT}")
    endif()
    set(BRQ_EXPORT_ARGS
        --language "${BRQ_TARGET_LANGUAGE}" --pak-root "${BRQ_PAK_ROOT}"
        --output "${BRQ_EXPORT_DIRECTORY}"
        --gust-g1t "${BRQ_GUST_G1T_EXECUTABLE}" --gust-ebm "${BRQ_GUST_EBM_EXECUTABLE}")
    foreach(kind IN ITEMS TTF)
        if(BRQ_RESOLVED_FONT_${kind})
            string(TOLOWER "${kind}" lower_kind)
            list(APPEND BRQ_EXPORT_ARGS --font-${lower_kind} "${BRQ_RESOLVED_FONT_${kind}}")
        endif()
    endforeach()
    if(BRQ_GUST_ENC_EXECUTABLE)
        list(APPEND BRQ_EXPORT_ARGS --gust-enc "${BRQ_GUST_ENC_EXECUTABLE}")
    endif()
    if(BRQ_EXPORT_PSD)
        find_program(BRQ_NODE_EXECUTABLE NAMES node REQUIRED)
        list(APPEND BRQ_EXPORT_ARGS --psd --node "${BRQ_NODE_EXECUTABLE}")
    endif()
    # Explicit export only: a normal build must never replace a translator's work.
    add_custom_target(brq-export
        COMMAND "${Python3_EXECUTABLE}" -B "${CMAKE_CURRENT_SOURCE_DIR}/tools/export_localization.py" ${BRQ_EXPORT_ARGS}
        VERBATIM USES_TERMINAL)
    message(STATUS "Translation workspace: ${BRQ_EXPORT_DIRECTORY}")
endif()
